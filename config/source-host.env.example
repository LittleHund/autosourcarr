# Integrated source engine configuration
# Release-managed file. The AutoSourcarr Settings cog edits this exact file.
# Restart AutoSourcarr after changes. The integrated process enforces loopback, port 4567 and WebView.

## Server
TZ=Europe/Amsterdam
AUTH_MODE=none
BIND_IP=127.0.0.1
BIND_PORT=4567
UPDATE_INTERVAL=0

## Extensions
EXTENSION_STORES=["https://github.com/keiyoushi/extensions/raw/repo/index.pb"]

## Source runtime
AUTO_DOWNLOAD_CHAPTERS=false
MAX_SOURCES_IN_PARALLEL=2

## FlareSolverr
# Optional existing solver, separate from the integrated source engine.
# AutoSourcarr checks readiness, retains your URL/session and bounds attempts.
# HTML response fallback is off by default to preserve source JSON API responses.
FLARESOLVERR_ENABLED=true
FLARESOLVERR_RESPONSE_AS_FALLBACK=false
FLARESOLVERR_SESSION_NAME=autosourcarr-source-host
FLARESOLVERR_SESSION_TTL=15
FLARESOLVERR_TIMEOUT=30
FLARESOLVERR_URL=http://192.168.1.121:8191

## Web UI & browser
KCEF_ENABLED=true
WEB_UI_CHANNEL=stable
WEB_UI_ENABLED=false
WEB_UI_FLAVOR=WebUI
