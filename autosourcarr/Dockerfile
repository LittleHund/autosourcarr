# Integrated application image. Build context stays ./autosourcarr.
# Release archives include bundled/ generated by scripts/sync-bundled-tools.py.
# All software installation is image-build-time; models/build caches are runtime data.
FROM eclipse-temurin:21-jdk-jammy AS browser-agent
WORKDIR /build
COPY source-browser-agent ./source-browser-agent
RUN mkdir classes && javac --add-exports java.base/jdk.internal.org.objectweb.asm=ALL-UNNAMED \
    -d classes source-browser-agent/SourceBrowserAgent.java \
    && jar cfm source-browser-agent.jar source-browser-agent/MANIFEST.MF -C classes .

# Android tools are architecture-specific; the deployment targeted here is TrueNAS x86-64.
FROM ghcr.io/cirruslabs/android-sdk:35 AS android-sdk
# API37 uses Google's exact package ID android-37.0 (android-37 does not exist).
# Retain API35/36 for older persisted Keiyoushi build-tree revisions.
RUN sdkmanager 'platforms;android-35' 'build-tools;35.0.0' \
       'platforms;android-36' 'build-tools;36.0.0' 'platforms;android-37.0' 'build-tools;37.0.0' \
    && test -s /opt/android-sdk-linux/platforms/android-37.0/android.jar \
    && test -x /opt/android-sdk-linux/build-tools/37.0.0/apksigner \
    && rm -rf /opt/android-sdk-linux/emulator /opt/android-sdk-linux/system-images

FROM node:22-bookworm-slim AS codex
ARG CODEX_VERSION=0.157.0
RUN npm install --global @openai/codex@${CODEX_VERSION} \
    && codex --version

# Keep the complete original JVM/KCEF/Xvfb runtime together.
# Registry metadata for v2.3.2243 identifies Temurin25 JRE on Ubuntu24.04 (noble).
FROM ghcr.io/suwayomi/suwayomi-server:v2.3.2243
USER root
ARG TARGETARCH
ARG FLARE_COMMIT=ff65b7cc6861b64b9558dcc9b5449aada88ff48a
ARG CHROME_VERSION=154.0.8037.57
ARG CHROME_SHA256=ceee2972074d441ea7c4ba8bcc0eaab77e7e87680f6653d73d3065851fe10302
ARG CHROMEDRIVER_SHA256=48edfc7f6e02ed85c45357110f18a54a82d8993b908cc9bfff9517b12abc96d9
ARG CFR_SHA256=f686e8f3ded377d7bc87d216a90e9e9512df4156e75b06c655a16648ae8765b2
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SOURCE_ENGINE_MODE=integrated APP_SERVICES_MODE=integrated
# Same distro as upstream source engine. Build tools are present before UID568 starts.
RUN test "${TARGETARCH:-amd64}" = amd64 \
    && apt-get update && apt-get install -y --no-install-recommends \
       python3 python3-venv git ripgrep ca-certificates curl zip unzip \
       util-linux bubblewrap xauth xvfb procps pkg-config gcc g++ \
       libgomp1 libstdc++6 libnss3 libnspr4 libdbus-1-3 libdrm2 libgbm1 \
       libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 \
       libxkbcommon0 libasound2t64 libatk1.0-0t64 libatk-bridge2.0-0t64 \
       libcups2t64 libpango-1.0-0 libcairo2 fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -c 'import sys; assert sys.version_info[:2] == (3,12), sys.version' \
    && python3 -m venv /opt/autosourcarr-venv \
    && python3 -m venv /opt/translate-venv \
    && python3 -m venv /opt/solver-venv
COPY --from=browser-agent /opt/java/openjdk /opt/build-jdk
COPY --from=android-sdk /opt/android-sdk-linux /opt/android-sdk-linux
COPY --from=codex /usr/local/bin/node /opt/node/bin/node
COPY --from=codex /usr/local/lib/node_modules/@openai /opt/node/lib/node_modules/@openai
RUN ln -s /opt/node/lib/node_modules/@openai/codex/bin/codex.js /opt/node/bin/codex \
    && /opt/build-jdk/bin/java -version && PATH="/opt/node/bin:$PATH" /opt/node/bin/codex --version \
    && test -x /opt/android-sdk-linux/build-tools/35.0.0/apksigner
RUN mkdir /opt/source-jvm \
    && curl --fail --location --retry 3 https://www.benf.org/other/cfr/cfr-0.152.jar -o /opt/source-jvm/cfr-0.152.jar \
    && printf '%s  /opt/source-jvm/cfr-0.152.jar\n' "$CFR_SHA256" | sha256sum -c - \
    && cp --link /home/suwayomi/startup/tachidesk_latest.jar /opt/source-jvm/source-api.jar

# Separate environments prevent helper HTTP/ML dependencies changing app pins.
# Pin CPU Torch explicitly: ordinary PyPI installation otherwise adds CUDA packages.
RUN /opt/translate-venv/bin/pip install --no-cache-dir \
       --index-url https://download.pytorch.org/whl/cpu 'torch==2.5.1+cpu' \
    && printf 'torch==2.5.1+cpu\n' > /tmp/translate-constraints.txt \
    && /opt/translate-venv/bin/pip install --no-cache-dir \
       --constraint /tmp/translate-constraints.txt 'libretranslate==1.8.4' \
    && /opt/translate-venv/bin/pip check \
    && rm /tmp/translate-constraints.txt

# Immutable FlareSolverr source revision; its bundled UC implementation is included.
# Driver path is moved from root-owned /app to a child-owned copy selected by manager.
RUN git clone https://github.com/FlareSolverr/FlareSolverr.git /opt/flaresolverr \
    && git -C /opt/flaresolverr checkout --detach ${FLARE_COMMIT} \
    && rm -rf /opt/flaresolverr/.git \
    && /opt/solver-venv/bin/pip install --no-cache-dir -r /opt/flaresolverr/requirements.txt \
    && /opt/solver-venv/bin/pip check \
    && /opt/autosourcarr-venv/bin/python -c "from pathlib import Path; p=Path('/opt/flaresolverr/src/utils.py'); s=p.read_text(); old='\"/app/chromedriver\"'; assert s.count(old)==2; p.write_text(s.replace(old, 'os.environ[\"AUTOSOURCARR_CHROMEDRIVER\"]'))"
# Same-version browser and driver, independently SHA256 verified. No Ubuntu Snap.
RUN curl --fail --location --retry 3 \
       "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION}/linux64/chrome-linux64.zip" -o /tmp/chrome.zip \
    && printf '%s  /tmp/chrome.zip\n' "$CHROME_SHA256" | sha256sum -c - \
    && curl --fail --location --retry 3 \
       "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION}/linux64/chromedriver-linux64.zip" -o /tmp/chromedriver.zip \
    && printf '%s  /tmp/chromedriver.zip\n' "$CHROMEDRIVER_SHA256" | sha256sum -c - \
    && unzip -q /tmp/chrome.zip -d /opt \
    && unzip -q /tmp/chromedriver.zip -d /opt \
    && ln -s /opt/chrome-linux64/chrome /usr/local/bin/google-chrome \
    && /opt/chrome-linux64/chrome --version \
    && /opt/chromedriver-linux64/chromedriver --version \
    && rm /tmp/chrome.zip /tmp/chromedriver.zip

ENV PATH="/opt/autosourcarr-venv/bin:${PATH}"
# Do not globally replace JAVA_HOME: source engine must retain upstream's JVM25.
ENV AUTOSOURCARR_BUILD_JAVA_HOME=/opt/build-jdk \
    AUTOSOURCARR_BUILD_ANDROID_HOME=/opt/android-sdk-linux
WORKDIR /app
COPY --from=browser-agent /build/source-browser-agent.jar /app/source-browser-agent.jar
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && pip check
COPY VERSION start-truenas.sh ./
COPY app ./app
COPY bundled /opt/autosourcarr-tools
RUN python3 /opt/autosourcarr-tools/build/scripts/check-linux-text.py /app/start-truenas.sh /opt/autosourcarr-tools \
    && ln -s /opt/autosourcarr-tools /app/bundled \
    && python3 -c 'from bundled.source_tools.archive import RawStore; from app.repair_history import RepairHistory' \
    && chmod 755 /opt/autosourcarr-tools/start-solver.sh \
    && test -x /usr/bin/setpriv \
    && mkdir -p /data /config \
    && cp VERSION /opt/autosourcarr-image-version \
    && test -f /opt/autosourcarr-tools/build/extension/module/build.gradle.kts \
    && test -f /opt/autosourcarr-tools/repair-worker/runner.py \
    && python3 -I /opt/autosourcarr-tools/repair-worker/codex_binary.py --link
# The image owns its default identity; retained explicit Compose users still work.
USER 568:568
EXPOSE 8282
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8282/api/v1/live', timeout=3)"
CMD ["/bin/sh","/app/start-truenas.sh"]
