<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="Unidecode.NET" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="FluentMigrator" />
    <PackageReference Include="FluentMigrator.Runner.Core" />
    <PackageReference Include="FluentMigrator.Runner.SQLite" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- Manifest resource names follow the folder path: AutoSourcarr.Core.<Folder>.<file> -->
    <EmbeddedResource Include="Matching/*.json" />
    <EmbeddedResource Include="Unicode/*.json" />
    <EmbeddedResource Include="Settings/*.json" />
    <EmbeddedResource Include="Persistence/Schema/*.sql" />
    <EmbeddedResource Include="Persistence/Schema/*.json" />
    <None Update="Unicode/Notices/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Repair/Notices/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Imaging/Notices/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
