<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <IsPackable>false</IsPackable>
    <!-- The ASP.NET route-handler analyzer crashes intermittently (AD0001 NullReferenceException in a solution build;
         the same sources build clean when the project is built alone). A crash of an analyzer stays a visible warning
         instead of failing the build; real analyzer findings are still errors. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);AD0001</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AutoSourcarr.Core/AutoSourcarr.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The 0.4.x orphan seed list (source_orphans_seed.json): embedded, not published as web content. -->
    <Content Remove="Resources/source-orphans-seed.json" />
    <EmbeddedResource Include="Resources/source-orphans-seed.json" LogicalName="AutoSourcarr.Api.source-orphans-seed.json" />
  </ItemGroup>
</Project>
