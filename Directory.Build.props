<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Phase 13: the image publishes ReadyToRun for linux-x64; the lock files record that runtime so locked restores hold. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <VersionPrefix>0.4.3</VersionPrefix>
    <VersionSuffix>migration</VersionSuffix>
    <RepositoryUrl>https://github.com/LittleHund/autosourcarr</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Company>AutoSourcarr</Company>
    <Product>AutoSourcarr</Product>
  </PropertyGroup>
</Project>
