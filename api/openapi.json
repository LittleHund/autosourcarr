{
  "openapi": "3.1.0",
  "info": {
    "title": "AutoSourcarr API",
    "version": "1"
  },
  "paths": {
    "/api/v1/config": {
      "get": {
        "operationId": "getConfig",
        "summary": "The running values the UI needs to describe this instance.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigView"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/diagnostics": {
      "get": {
        "operationId": "getDiagnostics",
        "summary": "PERF-9: all logs and diagnostics in one download, with secrets and private data removed.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/diagnostics/metrics": {
      "get": {
        "operationId": "getRuntimeMetrics",
        "summary": "Timing samples per work phase (no URLs, titles or keys).",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeMetricsSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/errors": {
      "get": {
        "operationId": "getErrors",
        "summary": "Recent errors grouped by cause with counts, newest first (resolved ones included).",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/errors/clear": {
      "post": {
        "operationId": "clearErrors",
        "summary": "Remove resolved errors (or all errors with resolved_only=false).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorsClearRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsClearResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Status page: version, databases, catalogue counts, active errors and dependency checks.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/jobs": {
      "get": {
        "operationId": "getJobs",
        "summary": "Job queue: workers, running and queued jobs with ETA, and per-type run limit, average time, failures and freezes.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "operationId": "getSettings",
        "summary": "Effective settings grouped as on the Settings page; secret values are hidden.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOverview"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      },
      "put": {
        "operationId": "saveSettings",
        "summary": "Save changed settings to config.json. Null resets a setting to its default; an empty secret removes it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsSaveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsSaveResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/settings/conversion": {
      "get": {
        "operationId": "getSettingsConversion",
        "summary": "What this start converted from autosourcarr.env to config.json.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionSummary"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/settings/schema": {
      "get": {
        "operationId": "getSettingsSchema",
        "summary": "The settings schema: name, type, default, description, secret, Compose variable and wizard step.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsSchemaResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/settings/update-notice": {
      "get": {
        "operationId": "getUpdateNotice",
        "summary": "What the last update changed in your settings, until dismissed.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateNoticeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/settings/update-notice/dismiss": {
      "post": {
        "operationId": "dismissUpdateNotice",
        "summary": "Hide the update notice.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateNoticeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/setup": {
      "get": {
        "operationId": "getSetup",
        "summary": "Setup wizard fields with the current values; secrets show only whether one is saved.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupView"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/setup/finish": {
      "post": {
        "operationId": "finishSetup",
        "summary": "Save the wizard\u0027s changes to config.json in one step; a repeated request id returns the first result.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupFinishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupFinishResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/setup/reader-preflight": {
      "post": {
        "operationId": "checkSetupReader",
        "summary": "Check draft reader addresses and key without saving them.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReaderPreflightRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderPreflightResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/setup/restart": {
      "post": {
        "operationId": "restartAfterSetup",
        "summary": "Restart the integrated image to apply saved settings.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestartResponse"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/status/stats": {
      "get": {
        "operationId": "getStatusStats",
        "summary": "Catalogue, chapter, source, cache and storage counts; refreshed at most every 15 seconds.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/storage/database": {
      "get": {
        "operationId": "getDatabaseStorage",
        "summary": "Where the databases are and how large they are.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseStorageView"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/storage/database/move": {
      "post": {
        "operationId": "moveDatabaseStorage",
        "summary": "Copy, check and switch both databases to another mounted folder (SET-5); the old files are kept.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DatabaseMoveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseMoveResponse"
                }
              }
            }
          },
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseMoveQueued"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/tasks": {
      "get": {
        "operationId": "getTasks",
        "summary": "Ongoing, completed and failed tasks with progress, ETA and finish time; job type, priority and queue position for queued work.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/tasks/clear-history": {
      "post": {
        "operationId": "clearTaskHistory",
        "summary": "Remove completed and failed tasks from the list; running and queued work stays.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/tasks/{taskId}/cancel": {
      "post": {
        "operationId": "cancelTask",
        "summary": "Cancel a queued or running task. Work already done stays; the task is listed as failed with \u0022Cancelled by user\u0022.",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskActionResponse"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    },
    "/api/v1/tasks/{taskId}/retry-safe": {
      "post": {
        "operationId": "retryTask",
        "summary": "Replay an interrupted task only when replaying it cannot change data twice (read-only observations).",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonObject"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid admin token"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfigView": {
        "type": "object",
        "properties": {
          "source_suwayomi_url": {
            "type": "string"
          },
          "autosourcarr_public_url": {
            "type": "string"
          },
          "main_suwayomi_url": {
            "type": "string"
          },
          "auto_match_threshold": {
            "type": "number"
          },
          "federated_source_timeout": {
            "type": "number"
          },
          "federated_overall_timeout": {
            "type": "number"
          },
          "source_languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata_identity_enabled": {
            "type": "boolean"
          },
          "metadata_identity_providers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata_identity_include_adult": {
            "type": "boolean"
          },
          "admin_token_required": {
            "type": "boolean"
          }
        },
        "required": [
          "source_suwayomi_url",
          "autosourcarr_public_url",
          "main_suwayomi_url",
          "auto_match_threshold",
          "federated_source_timeout",
          "federated_overall_timeout",
          "source_languages",
          "metadata_identity_enabled",
          "metadata_identity_providers",
          "metadata_identity_include_adult",
          "admin_token_required"
        ]
      },
      "ConversionSummary": {
        "type": "object",
        "properties": {
          "converted": {
            "type": "boolean"
          },
          "converted_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "backup_directory": {
            "type": [
              "string",
              "null"
            ]
          },
          "setting_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_host_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extra_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "encrypted_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "invalid_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keys_without_value": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "converted",
          "converted_at",
          "backup_directory",
          "setting_keys",
          "source_host_keys",
          "extra_keys",
          "encrypted_keys",
          "invalid_keys",
          "keys_without_value"
        ]
      },
      "DatabaseMoveQueued": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "target_directory": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "target_directory",
          "message"
        ]
      },
      "DatabaseMoveRequest": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "DatabaseMoveResponse": {
        "type": "object",
        "properties": {
          "from_directory": {
            "type": "string"
          },
          "target_directory": {
            "type": "string"
          },
          "catalog_bytes": {
            "type": "integer"
          },
          "origins_bytes": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "from_directory",
          "target_directory",
          "catalog_bytes",
          "origins_bytes",
          "message"
        ]
      },
      "DatabaseStorageView": {
        "type": "object",
        "properties": {
          "active_dir": {
            "type": "string"
          },
          "configured_dir": {
            "type": [
              "string",
              "null"
            ]
          },
          "catalog_bytes": {
            "type": "integer"
          },
          "origins_bytes": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          },
          "move_available": {
            "type": "boolean"
          },
          "move_note": {
            "type": "string"
          },
          "pending_relocation": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "active_dir",
          "configured_dir",
          "catalog_bytes",
          "origins_bytes",
          "bytes",
          "move_available",
          "move_note",
          "pending_relocation"
        ]
      },
      "ErrorsClearRequest": {
        "type": "object",
        "properties": {
          "resolved_only": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "resolved_only"
        ]
      },
      "ErrorsClearResponse": {
        "type": "object",
        "properties": {
          "cleared": {
            "type": "integer"
          }
        },
        "required": [
          "cleared"
        ]
      },
      "JsonObject": {
        "type": "object"
      },
      "ProblemResponse": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "detail"
        ]
      },
      "ReaderPreflightRequest": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string"
          },
          "changes": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "revision",
          "changes"
        ]
      },
      "ReaderPreflightResponse": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string"
          },
          "reader_build": {
            "type": "object",
            "properties": {
              "ready": {
                "type": "boolean"
              },
              "exit_code": {
                "type": "integer"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "key",
                    "code",
                    "message"
                  ]
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "#/properties/reader_build/properties/errors/items"
                }
              }
            },
            "required": [
              "ready",
              "exit_code",
              "errors",
              "warnings"
            ]
          }
        },
        "required": [
          "revision",
          "reader_build"
        ]
      },
      "RestartResponse": {
        "type": "object",
        "properties": {
          "restarting": {
            "type": "boolean"
          }
        },
        "required": [
          "restarting"
        ]
      },
      "RuntimeMetricsSnapshot": {
        "type": "object",
        "properties": {
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "samples": {
                  "type": "integer"
                },
                "p50_ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "p95_ms": {
