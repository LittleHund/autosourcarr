# Build context of docker/Dockerfile (repository root). Keep it small and free of local state.
.git
.github
.build
**/bin
**/obj
**/node_modules
probe
test-results
playwright-report
runtime-config
**/*.env
autosourcarr/app/static/dist
autosourcarr/tests
autosourcarr/bundled
**/__pycache__
**/.gradle
**/build
extension/dist
# The 0.4.x extension builder's output (reader key in BuildAuth.kt, signed APKs) never enters a build layer.
extension/.build
extension/dist-instances
config/.extension-signing
config/extension-downloads
