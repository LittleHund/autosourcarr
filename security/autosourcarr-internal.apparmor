# AutoSourcarr derivative of Moby's default AppArmor template at
# 85e237f1fe229a0c61c9c7d8e743fa780d3b97ca (2026-09-28 retrieval).
# Changes: fixed profile/daemon names, standalone PROC variable, and namespace
# mount/remount/pivot_root permissions required by rootless bubblewrap.
# No unconfined/complain flag, SYS_ADMIN capability, Docker socket or host root.
# The enclosing container must remain non-root with cap_drop: [ALL]. These LSM
# permissions do not grant kernel capabilities; mount operations remain subject
# to user-namespace ownership/capability checks.
# ABI 3.0 follows Moby and keeps unix sockets covered by network. Do not import
# abstractions/base here: newer distro variants can silently upgrade its ABI.
abi <abi/3.0>,
@{PROC}=/proc

profile autosourcarr-internal flags=(attach_disconnected,mediate_deleted) {
  network,
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  # Add an exact receive peer here if the host daemon has a custom profile.
  signal (send,receive) peer=autosourcarr-internal,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # Bubblewrap builds a temporary mount tree in its mandatory new user/mount
  # namespaces. Match all staging paths; kernel namespace checks still apply.
  mount,
  remount,
  pivot_root,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,tracedby,read,readby) peer=autosourcarr-internal,
}
