# runtime and private data — never committed
runtime-config/
retained-env/
data/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.env
!*.env.example
!config/*.env.example
config/autosourcarr.env
config/source-host.env
# build output
bin/
obj/
.vs/
*.user
__pycache__/
*.pyc
.pytest_cache/
node_modules/
conversion-export/
lockfiles.txt
# Web UI build output (scripts/bundle-ui.mjs) and browser test results
autosourcarr/app/static/dist/
test-results/
playwright-report/
# The owner's duplicate decisions (removed before cutover); a local copy stays out of the repository
tests/AutoSourcarr.Tests/Fixtures/matching/duplicate-pairs.user.json

# Local build and test output (reader extension, source host, wrapper test runs)
/.build/

# The 0.4.x extension builder (extension/build-in-container.sh) writes the reader key, signed APKs and the signing
# keystore here when run in a project folder: never committed (rule 11).
extension/.build/
extension/dist/*
!extension/dist/README.txt
extension/dist-instances/
config/.extension-signing/
config/extension-downloads/
