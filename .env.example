# Enable supported extension CAPTCHA settings and check the configured Cloudflare solver.
SOURCE_AUTO_CHALLENGES=true
DATA_DIR=/data
DATABASE_DIR=/data
# TrueNAS example. Change tank/apps to your actual dataset path.
TZ=Europe/Amsterdam
DATA_ROOT=/mnt/tank/apps/autosourcarr

# Host ports. The private source host only needs to be reachable for setup/admin.
SOURCE_HOST_PORT=4568
AUTOSOURCARR_PORT=8282

# Internal URL baked into the Suwayomi JAR. Docker service DNS is preferred on the shared network.
AUTOSOURCARR_INTERNAL_URL=http://autosourcarr:8282
# External URL baked into the Tachiyomi/Mihon APK. Use a LAN URL or your normal Authelia-protected HTTPS hostname.
AUTOSOURCARR_PUBLIC_URL=http://192.168.1.100:8282
# External APK reader API secret. Use a random 64+ character value.
AUTOSOURCARR_READER_API_TOKEN=
# Deprecated legacy Authelia Basic fields; v0.2.68+ uses the AutoSourcarr reader API token instead.
AUTOSOURCARR_AUTHELIA_BASIC_USERNAME=
AUTOSOURCARR_AUTHELIA_BASIC_PASSWORD=

# Which private Mihon sources AutoSourcarr may expose by default.
# Initial defaults only; later language choices are stored in catalog.sqlite
SOURCE_LANGUAGES=en,all
MAX_SOURCE_CONCURRENCY=6
SOURCE_HOST_WORK_CONCURRENCY=4
FEDERATED_SOURCE_TIMEOUT=8
FEDERATED_OVERALL_TIMEOUT=14
INTERACTIVE_SOURCE_TIMEOUT=4
INTERACTIVE_OVERALL_TIMEOUT=6
FEDERATED_ITEMS_PER_SOURCE=30
SEARCH_CACHE_TTL_SECONDS=20
SEARCH_CACHE_MAX_ENTRIES=128
SUBBED_CACHE_TTL_SECONDS=10
COVER_HINT_CACHE_MAX_ENTRIES=10000
SOURCE_FAILURE_THRESHOLD=3
SOURCE_COOLDOWN_SECONDS=120
CHAPTER_PAGE_CACHE_TTL_SECONDS=1800
PAGE_INFO_CACHE_MAX_ENTRIES=4096
QUALITY_ANALYSIS_CONCURRENCY=2
QUALITY_SAMPLE_TIMEOUT=20
QUALITY_OVERALL_TIMEOUT=60
COLOR_DETECTION_ENABLED=true
COLOR_DETECTION_SAMPLE_PAGES=4
COLOR_DETECTION_COLORED_PIXEL_FRACTION=0.06
COLOR_DETECTION_MIN_CONFIDENCE=0.78
COLOR_DETECTION_TIMEOUT=8
DUPLICATE_SIGNATURE_MAX_BUCKET=24
DUPLICATE_SNAPSHOT_TTL_SECONDS=60
DUPLICATE_AUTO_MERGE_MIN_EXACT_TITLES=2
DUPLICATE_AUTO_MERGE_SUMMARY_THRESHOLD=0.70
DUPLICATE_AUTO_MERGE_MIN_SUMMARY_CHARS=80
SQLITE_CACHE_MB=64
HTTP_MAX_CONNECTIONS=64
HTTP_MAX_KEEPALIVE_CONNECTIONS=32
HTTP_KEEPALIVE_EXPIRY_SECONDS=30
HTTP_TRANSPORT_RETRIES=1
BROWSE_CACHE_REFRESH_SECONDS=600
BROWSE_PREFETCH_PAGES=2
BACKGROUND_REFRESH_ON_STARTUP=true
STARTUP_REFRESH_DELAY_SECONDS=20
BACKGROUND_DEDUP_ON_STARTUP=true
AUTOMATIC_DUPLICATE_MATCHING=true
AUTOMATIC_DUPLICATE_MATCHING_DELAY_SECONDS=8
EXACT_THUMBNAIL_MATCHING=true
THUMBNAIL_FINGERPRINT_TTL_SECONDS=2592000
THUMBNAIL_FINGERPRINT_TIMEOUT=8
THUMBNAIL_FINGERPRINT_ENTRIES_PER_PASS=500
AUTHELIA_USER_HEADER=
COVER_FETCH_TIMEOUT=5
COVER_INLINE_WAIT=0.35
COVER_FETCH_CONCURRENCY=4
MANUAL_SEARCH_TIMEOUT=12
MANUAL_SEARCH_OVERALL_TIMEOUT=24
MANUAL_SEARCH_ALIAS_LIMIT=30
MANUAL_SEARCH_LIVE_QUERY_LIMIT=4
MANUAL_TRANSLATION_QUERY_LIMIT=6
MANUAL_TRANSLATE_CANDIDATE_LIMIT=12
AUTO_MISSING_SOURCE_DISCOVERY=true
AUTO_MISSING_SOURCE_ENTRIES_PER_FEED=10
AUTO_MISSING_SOURCE_SOURCE_LIMIT=8
# Recovery budgets keep slow sources/items retryable while preserving completed work.
SOURCE_RECOVERY_TIMEOUT_SECONDS=45
SUBBED_SEARCH_ENTRY_TIMEOUT_SECONDS=120
AUTO_VARIANT_DISCOVERY=true
AUTO_VARIANT_MIN_SCORE=0.96
AUTO_VARIANT_QUERY_LIMIT=6
AUTO_VARIANT_ENTRIES_PER_FEED=20
AUTO_VARIANT_SOURCE_TIMEOUT=6
AUTO_VARIANT_OVERALL_TIMEOUT=14
AUTO_VARIANT_STARTUP_ENTRIES=50
AUTO_VARIANT_STARTUP_DELAY_SECONDS=70
TRANSLATION_API_URL=http://autosourcarr-translate:5000
TRANSLATION_TIMEOUT=5
TRANSLATION_OVERALL_TIMEOUT=7
TRANSLATION_CONCURRENCY=4
TRANSLATION_TARGET_LANGUAGES=ja,ko,zh
BACKGROUND_TRANSLATION_ON_DISCOVERY=true
BACKGROUND_TRANSLATION_ENTRIES_PER_FEED=12
BACKGROUND_TRANSLATION_ENTRIES_PER_STARTUP=40
TRANSLATION_STARTUP_DELAY_SECONDS=45
REFRESH_SOURCE_TIMEOUT=12
REFRESH_OVERALL_TIMEOUT=25
SOURCE_HOST_MAX_PARALLEL=4
BROWSE_PAGE_SIZE=50
AUTO_MATCH_THRESHOLD=0.94
FUZZY_REVIEW_THRESHOLD=0.78

# Optional. If set, AutoSourcarr Admin API requires this token.
# The public source API stays reachable so the Suwayomi extension can use it.
ADMIN_TOKEN=

# Main Suwayomi connection used by the Subbed tab.
MAIN_SUWAYOMI_URL=http://suwayomi:30058
# Optional: mount the main Suwayomi AutoSourcarr downloads folder read-only and set its container path here.
MAIN_SUWAYOMI_DOWNLOADS_PATH=/mnt/manga-downloads

# Background metadata hydration for entries whose source search result omitted
# cover/description/author. This does not block initial Browse results.
METADATA_ENRICHMENT_ENTRIES_PER_FEED=30
METADATA_ENRICHMENT_CONCURRENCY=4
METADATA_ENRICHMENT_SOURCE_LIMIT=3
METADATA_ENRICHMENT_TIMEOUT=10
METADATA_ENRICHMENT_ON_STARTUP=true
METADATA_ENRICHMENT_STARTUP_DELAY_SECONDS=8
METADATA_ENRICHMENT_STARTUP_LIMIT=500
